 InterpretationBox[
  RowBox[{"\<\"dtEuler:\"\>", "\[InvisibleSpace]", "18.367346938775512`"}],
  SequenceForm["dtEuler:", 18.367346938775512`],
  Editable->False]], "Print",
 CellChangeTimes->{{3.9872857660267076`*^9, 3.987285782077804*^9}, 
   3.987286147029372*^9},
