Cell[CellGroupData[{

Cell["3. Build Euler Step with Neural Network ", "Subsection",
 CellChangeTimes->{{3.98727718935011*^9, 3.987277200081718*^9}, {
  3.98727723254666*^9, 
  3.987277239436586*^9}},ExpressionUUID->"4d9d2281-f53b-415c-a52c-\
04e0b76de0fc"],

Cell[CellGroupData[{

Cell["\<\
 Each of the function below is the neural network version of the Euler \
function created in Stage 1\
\>", "Item",
 CellChangeTimes->{{3.9872774178641148`*^9, 
  3.987277470812869*^9}},ExpressionUUID->"8bc7238c-e695-4808-979a-\
8415df1956ad"],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
 "eulerRHS"], "InlineCode",ExpressionUUID->
  "53945be9-6efb-488e-8b59-1a53ca39a3db"],
 "  \[RightArrow]",
 Cell[BoxData[
  RowBox[{" ", "nnEulerRHS"}]], "InlineCode",ExpressionUUID->
  "c75300c4-76f6-4c6d-9da4-53829f46f416"]
}], "Subitem",
 CellChangeTimes->{{3.9872774178641148`*^9, 3.987277470465952*^9}, {
  3.987277560304184*^9, 3.987277609613303*^9}, {3.987277722624625*^9, 
  3.987277732997756*^9}},ExpressionUUID->"2808468c-868d-48f5-9235-\
11bf6d1c2419"],

Cell["\<\
Here, we want to build a neural network representation of chemical rate law \
f(y)=W.y where f(y) is the rate of change of each species, W or weight matrix \
is the 2x2 matrix that encode constant k for each species, and y is [A] and \
[B] at time t \
\>", "Subsubitem",
 CellChangeTimes->{{3.9872774178641148`*^9, 3.987277470465952*^9}, {
  3.987277560304184*^9, 3.987277609613303*^9}, {3.987277722624625*^9, 
  3.987277928439851*^9}, {3.987277974062752*^9, 3.987277977984111*^9}, {
  3.9872780196507053`*^9, 3.987278030471195*^9}, {3.98727810428509*^9, 
  3.987278119378251*^9}, {3.9872781743221617`*^9, 
  3.987278216944868*^9}},ExpressionUUID->"d26061eb-6c8a-4d72-b5da-\
c56b8da4b05f"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{" ", "nnEulerRHS"}]], "InlineCode",ExpressionUUID->
  "1757b450-420d-40d8-9f70-edbf6b05f5cf"],
 " compute f(y)= W.y rate of change by taking in 2 input (y vector that has \
[A] and [B] at time t)and and output ",
 Cell[BoxData[
  FormBox[
   FractionBox["dA", "dt"], TraditionalForm]],ExpressionUUID->
  "dca29929-8175-48e6-bccc-9564b60af23f"],
 " and ",
 Cell[BoxData[
  FormBox[
   FractionBox["dB", "dt"], TraditionalForm]],ExpressionUUID->
  "7cb4bad8-168d-4af3-aebc-8768496dae99"],
 "  "
}], "Subsubitem",
 CellChangeTimes->{{3.9872774178641148`*^9, 3.987277470465952*^9}, {
  3.987277560304184*^9, 3.987277609613303*^9}, {3.987277722624625*^9, 
  3.987277928439851*^9}, {3.987277974062752*^9, 3.987277977984111*^9}, {
  3.9872780196507053`*^9, 3.987278030471195*^9}, {3.98727810428509*^9, 
  3.987278119378251*^9}, {3.9872781743221617`*^9, 3.98727824305504*^9}, {
  3.987278408088089*^9, 3.987278408953701*^9}, {3.987278507876587*^9, 
  3.9872785147086143`*^9}, {3.987278559696582*^9, 
  3.987278691952836*^9}},ExpressionUUID->"81f50220-04b9-42c1-9bee-\
1cc62f9edeb3"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
 "eulerStep"], "Item",ExpressionUUID->
  "8a73a9fe-48a7-4dc1-b963-1508ab4ea057"],
 "1 \[RightArrow] ",
 Cell[BoxData[
 "eulerStepNet"], "InlineCode",ExpressionUUID->
  "13deecf3-b06b-4a8c-a0f8-3ce50652abf6"]
}], "Subitem",
 CellChangeTimes->{{3.9872774178641148`*^9, 3.987277470465952*^9}, {
  3.987277560304184*^9, 3.987277620599802*^9}, {3.987277659509198*^9, 
  3.987277682475964*^9}, {3.987278287453535*^9, 
  3.987278287455432*^9}},ExpressionUUID->"b2a52c34-e4b4-4ddb-8ba3-\
9dce44e3e79b"],

Cell[TextData[{
 Cell[BoxData[
 "eulerStepNet"], "InlineCode",ExpressionUUID->
  "0fd47c4a-cb38-4334-9003-f563c566f9f2"],
 " is the neural network representation of the concentration in the next time \
step. "
}], "Subsubitem",
 CellChangeTimes->{{3.9872774178641148`*^9, 3.987277470465952*^9}, {
  3.987277560304184*^9, 3.987277620599802*^9}, {3.987277659509198*^9, 
  3.987277682475964*^9}, {3.987278294635606*^9, 
  3.987278399685482*^9}},ExpressionUUID->"6faef806-b7a1-4c93-933e-\
2dbbf4f60ec1"],

Cell[TextData[{
 "The initial concentration is feed into 1) \[OpenCurlyDoubleQuote]rhs\
\[CloseCurlyDoubleQuote] (or nnEulerRHS function) to compute ",
 Cell[BoxData[
  FormBox["dy", TraditionalForm]],ExpressionUUID->
  "3350cb71-d029-4dc4-9957-94ea9029df88"],
 " (which is ",
 Cell[BoxData[
  FormBox[
   FractionBox["dA", "dt"], TraditionalForm]],ExpressionUUID->
  "39391c48-f39b-4d23-ba7d-327231bd58d4"],
 " and ",
 Cell[BoxData[
  FormBox[
   FractionBox["dB", "dt"], TraditionalForm]],ExpressionUUID->
  "382a5acd-c78d-4ea7-adc8-04fcc31a95a4"],
 " ) and 2) the \[OpenCurlyDoubleQuote]euler\[CloseCurlyDoubleQuote] which \
compute y+dtEuler*dy"
}], "Subsubitem",
 CellChangeTimes->{{3.9872774178641148`*^9, 3.987277470465952*^9}, {
  3.987277560304184*^9, 3.987277620599802*^9}, {3.987277659509198*^9, 
  3.987277682475964*^9}, {3.987278294635606*^9, 3.9872783994891253`*^9}, {
  3.987278752261632*^9, 
  3.987278931333529*^9}},ExpressionUUID->"bd5c559d-6385-4679-8174-\
e37f29b01c6a"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  FormBox["dy", TraditionalForm]],ExpressionUUID->
  "9bc9443a-859a-4c29-a6f9-b1e7df8da837"],
 " computed by \[OpenCurlyDoubleQuote]rhs\[CloseCurlyDoubleQuote] will be \
feed to \[OpenCurlyDoubleQuote]euler\[CloseCurlyDoubleQuote] to finish \
calculating the output y+dtEuler*dy after one time step "
}], "Subsubitem",
 CellChangeTimes->{{3.9872774178641148`*^9, 3.987277470465952*^9}, {
  3.987277560304184*^9, 3.987277620599802*^9}, {3.987277659509198*^9, 
  3.987277682475964*^9}, {3.987278294635606*^9, 3.9872783994891253`*^9}, {
  3.987278752261632*^9, 3.9872790029463367`*^9}, {3.9872790504526377`*^9, 
  3.9872790576407137`*^9}},ExpressionUUID->"abf187a8-1576-4a90-812e-\
edbc732eab6c"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"eulerSolve1", " "}]], "InlineCode",ExpressionUUID->
  "19f0a65c-a6a6-447f-8b53-fd5c22ff3294"],
 "\[RightArrow] ",
 Cell[BoxData[
 "eulerSolveNet"], "InlineCode",ExpressionUUID->
  "91e2f3d4-ed72-4fb7-a8b7-60b81074d4e3"]
}], "Subitem",
 CellChangeTimes->{{3.9872774178641148`*^9, 3.987277470465952*^9}, {
  3.987277560304184*^9, 3.987277620599802*^9}, {3.987277659509198*^9, 
  3.987277715928028*^9}, {3.9872790830514297`*^9, 
  3.9872790830560703`*^9}},ExpressionUUID->"42b369e8-d371-4c8d-9701-\
fdf0a9bef442"],

Cell["\<\
Instead of NestList in eulerSolve1 in Stage 1, use NetNestOperator for neural \
network in Stage 2\
\>", "Subsubitem",
 CellChangeTimes->{{3.9872774178641148`*^9, 3.987277470465952*^9}, {
  3.987277560304184*^9, 3.987277620599802*^9}, {3.987277659509198*^9, 
  3.987277715928028*^9}, {3.987279509897525*^9, 3.987279554553926*^9}, {
  3.9872796241866713`*^9, 
  3.98727962716298*^9}},ExpressionUUID->"c1e842df-9ffc-4bab-9963-\
9a74595dfbfb"],

Cell[CellGroupData[{

Cell["\<\
Only use move 5 step forward instead of 50 because during NetTrain \
backpropagation will not work if it has to do 50 forward and backward because \
the gradient dtEuler (smaller than zero) is going to be too small \
(essentially 0 after 50 layers)\
\>", "Subsubitem",
 CellChangeTimes->{{3.9872774178641148`*^9, 3.987277470465952*^9}, {
   3.987277560304184*^9, 3.987277620599802*^9}, {3.987277659509198*^9, 
   3.987277715928028*^9}, {3.987279509897525*^9, 3.987279554553926*^9}, {
   3.9872796241866713`*^9, 3.987279714111017*^9}, {3.987279788208393*^9, 
   3.987279804074553*^9}, {3.987279838904508*^9, 3.987279847934072*^9}, 
   3.987279888353849*^9, {3.9872799921513853`*^9, 
   3.9872800265889883`*^9}},ExpressionUUID->"b44d3585-aeb4-4d3d-bb74-\
118a2c6bf644"],

Cell[CellGroupData[{

