Cell[CellGroupData[{

Cell["2. Generate data", "Subsection",
 CellChangeTimes->{{3.987258291959193*^9, 
  3.987258294971292*^9}},ExpressionUUID->"7ec8d66f-fdb5-4e49-b48b-\
485c2ad756ab"],

Cell[TextData[{
 " In Stage 1, we assume ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    SubscriptBox["A", "0"], "]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d04581a2-f3e7-4bfe-a3e7-4275847c27d7"],
 " =1. In Stage 2 to increase the amount of training data available, we \
generate 20 different concentration"
}], "Item",
 CellChangeTimes->{{3.987276035490095*^9, 3.987276057839521*^9}, {
  3.9872761064923058`*^9, 3.987276176809279*^9}, {3.987276451881151*^9, 
  3.987276451883766*^9}},ExpressionUUID->"7d7921d1-8317-40f8-b720-\
da12eca4dc03"],

Cell[CellGroupData[{

Cell["\<\
The Table function generate data noisy data for both [A] and [B]\
\>", "Item",
 CellChangeTimes->{{3.987276035490095*^9, 3.987276057839521*^9}, {
  3.9872761064923058`*^9, 3.987276176809279*^9}, {3.987276714614985*^9, 
  3.98727674354275*^9}},ExpressionUUID->"73e6c443-0ae0-4f94-b23c-\
53f7c6cd55bd"],

Cell[CellGroupData[{

Cell[TextData[{
 "the inputStateN and targetStateN are set of data corresponded to the \
initial concentration and concentration after nStepsNN respectively (for \
example  inputStateN contain ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    SubscriptBox["A", "0"], "]"}], TraditionalForm]],ExpressionUUID->
  "a4679e3c-2a6f-44e4-a283-7cc94d0e901f"],
 "  to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    SubscriptBox["A", "4"], "]"}], TraditionalForm]],ExpressionUUID->
  "9b3585c8-ebe1-4694-ac95-7643896e80fd"],
 "  and targetStageN contain ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    SubscriptBox["A", "5"], "]"}], TraditionalForm]],ExpressionUUID->
  "1e0363a1-c58e-4c23-96fd-9e2fdfa4ad97"],
 "  to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    SubscriptBox["A", "9"], "]"}], TraditionalForm]],ExpressionUUID->
  "ad534dc3-28c4-4bcf-a012-fb709cb1a279"],
 ".  inputStateN will serve as input and targetStageN  will serves as output \
for the neural network in the later section)"
}], "Subitem",
 CellChangeTimes->{{3.987276035490095*^9, 3.987276057839521*^9}, {
  3.9872761064923058`*^9, 3.987276176809279*^9}, {3.987276714614985*^9, 
  3.987276780250095*^9}, {3.987276861230237*^9, 
  3.987277108541505*^9}},ExpressionUUID->"4f185b95-3971-4129-bef1-\
75ec9ca62da3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"initialAs", "=", 
    RowBox[{"Range", "[", 
     RowBox[{"0.1", ",", "2.0", ",", "0.1"}], "]"}]}], ";"}], "  ", 
  RowBox[{"(*", 
   RowBox[{"20", " ", "starting", " ", "concentrations"}], "*)"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"inputStatesN", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"targetStatesN", "=", 
    RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"a0", "=", "ia"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Aclean", "=", 
       RowBox[{"a0", "*", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "kTrue"}], "*", "tGrid1"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Bclean", "=", 
       RowBox[{"a0", "*", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "kTrue"}], "*", "tGrid1"}], "]"}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{
         "5", "%", " ", "Gaussian", " ", "noise", " ", "like", " ", "Stage", " ",
           "1", " ", "and", " ", "Ji"}], "&"}], " ", "Deng", " ", "paper"}], 
       "*)"}], 
      RowBox[{"noiseA", "=", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"0", ",", "0.05"}], "]"}], ",", "nPoints"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"noiseB", "=", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"0", ",", "0.05"}], "]"}], ",", "nPoints"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "clamp", " ", "negative", " ", "concentrations", " ", "to", " ", 
        "zero"}], "*)"}], 
      RowBox[{"Anoisy", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"#", ",", "0"}], "]"}], "&"}], ",", 
         RowBox[{"Aclean", "*", 
          RowBox[{"(", 
           RowBox[{"1", "+", "noiseA"}], ")"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Bnoisy", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"#", ",", "0"}], "]"}], "&"}], ",", 
         RowBox[{"Bclean", "*", 
          RowBox[{"(", 
           RowBox[{"1", "+", "noiseB"}], ")"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"traj", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"Anoisy", ",", "Bnoisy"}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"nStepsNN", "-", 
        RowBox[{
        "step", " ", "pairs", " ", "within", " ", "each", " ", "trajectory", " ",
          "only"}]}], "*)"}], 
      RowBox[{"AppendTo", "[", 
       RowBox[{"inputStatesN", ",", 
        RowBox[{"traj", "[", 
         RowBox[{"[", 
          RowBox[{"1", ";;", 
           RowBox[{
            RowBox[{"-", "nStepsNN"}], "-", "1"}]}], "]"}], "]"}]}], "]"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"targetStatesN", ",", 
        RowBox[{"traj", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"nStepsNN", "+", "1"}], ";;"}], "]"}], "]"}]}], "]"}], 
      ";"}], ",", 
     RowBox[{"{", 
      RowBox[{"ia", ",", "initialAs"}], "}"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"inputStatesN", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"inputStatesN", ",", "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"targetStatesN", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"targetStatesN", ",", "1"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{3.987276191031321*^9},
 CellLabel->"In[34]:=",ExpressionUUID->"aae091e3-277c-49b3-b412-2e48867e14e0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"ListPlot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"tGrid1", ",", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "kTrue"}], "*", "tGrid1"}], "]"}]}], "}"}], "]"}], ",", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"tGrid1", ",", "Anoisy"}], "}"}], "]"}]}], "}"}], ",", 
    RowBox[{"PlotLegends", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Clean A\>\"", ",", "\"\<Noisy A (5%)\>\""}], "}"}]}], ",", 
    
    RowBox[{
    "PlotLabel", "->", "\"\<Stage 2: Training Data Clean vs Noisy\>\""}], ",", 
    RowBox[{"AxesLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Time\>\"", ",", "\"\<Concentration\>\""}], "}"}]}], ",", 
    RowBox[{"Joined", "->", 
     RowBox[{"{", 
      RowBox[{"True", ",", "False"}], "}"}]}], ",", 
    RowBox[{"PlotStyle", "->", 
     RowBox[{"{", 
      RowBox[{"Blue", ",", "Red"}], "}"}]}]}], "]"}], 
  "\[IndentingNewLine]"}]], "Input",
 CellLabel->"In[40]:=",ExpressionUUID->"c8c35234-4322-44d3-80d5-fcde476c9409"],

