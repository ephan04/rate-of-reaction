Cell[BoxData[
 RowBox[{"eulerStepNet", "=", 
  RowBox[{"NetGraph", "[", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<rhs\>\"", "->", "nnEulerRHS"}], ",", 
      RowBox[{"\"\<euler\>\"", "->", 
       RowBox[{"ThreadingLayer", "[", 
