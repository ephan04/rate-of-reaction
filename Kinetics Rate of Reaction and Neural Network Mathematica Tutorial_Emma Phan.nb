Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"loss1", "[", 
     RowBox[{"kVal_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"pred", ",", "predA"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"pred", "=", 
        RowBox[{"eulerSolve1", "[", "kVal", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"predA", "=", 
        RowBox[{"pred", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Mean", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{"predA", "-", "Adata"}], "]"}], "]"}]}]}], 
     RowBox[{"(*", 
      RowBox[{
      "the", " ", "average", " ", "different", " ", "of", " ", "Euler", " ", 
       "step", " ", "vs", " ", "synthetic", " ", "A", " ", "data"}], "*)"}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"kLearn", "=", "0.5"}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"learnRate", "=", "0.01"}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nEpochs1", "=", " ", "100"}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lossHistory1", "=", 
    RowBox[{"Table", "[", 
     RowBox[{"0", ",", 
      RowBox[{"{", "nEpochs1", "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"grad", "=", 
      RowBox[{"First", "[", 
       RowBox[{
        RowBox[{"Grad", "[", 
         RowBox[{
          RowBox[{"loss1", "[", "k", "]"}], ",", 
          RowBox[{"{", "k", "}"}]}], "]"}], "/.", " ", 
        RowBox[{"k", "->", "kLearn"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"kLearn", "=", 
      RowBox[{"kLearn", "-", 
       RowBox[{"learnRate", "*", "grad"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"kLearn", "=", 
      RowBox[{"Max", "[", 
       RowBox[{"kLearn", ",", 
        RowBox[{"10", "^", 
         RowBox[{"-", "6"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"lossHistory1", "[", 
       RowBox[{"[", "ep", "]"}], "]"}], "=", 
      RowBox[{"loss1", "[", "kLearn", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Mod", "[", 
         RowBox[{"ep", ",", "10"}], "]"}], "==", "0"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Epoch \>\"", ",", "ep", ",", "\"\<  k = \>\"", ",", 
         RowBox[{"NumberForm", "[", 
          RowBox[{"kLearn", ",", "4"}], "]"}], ",", "\"\<  loss = \>\"", ",", 
         
         RowBox[{"NumberForm", "[", 
          RowBox[{
           RowBox[{"lossHistory1", "[", 
            RowBox[{"[", "ep", "]"}], "]"}], ",", "3"}], "]"}]}], "]"}]}], 
      "]"}]}], "\[IndentingNewLine]", ",", 
    RowBox[{"{", 
     RowBox[{"ep", ",", "nEpochs1"}], "}"}]}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.987253291116399*^9, 3.987253291660323*^9}, {
  3.987253942646117*^9, 3.987253945512125*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"60be5724-3e04-44fe-bf9f-6091467d7c1c"],

