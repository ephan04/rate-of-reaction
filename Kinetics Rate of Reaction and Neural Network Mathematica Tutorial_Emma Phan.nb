Cell[CellGroupData[{

Cell[TextData[{
 "The function ",
 Cell[BoxData[
 "eulerSolve"], "InlineCode",ExpressionUUID->
  "86ef22ca-cd49-4174-b7dc-bd7cdb07505b"],
 "1 apply the initial concentration to ",
 Cell[BoxData[
 "eulerStep"], "InlineCode",ExpressionUUID->
  "10ca2ca7-b8ba-4cd7-8936-d7d861850ad4"],
 "1 forward 50 times step "
}], "Item",
 CellChangeTimes->{{3.98725300160667*^9, 
  3.987253135980104*^9}},ExpressionUUID->"bddc1559-5867-4e8c-9533-\
cda7990608da"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"eulerRHS", "[", 
     RowBox[{"yList_", ",", "kVal_"}], "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "kVal"}], "*", 
       RowBox[{"yList", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"kVal", "*", 
       RowBox[{"yList", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], " ", "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dtEuler", "=", 
   RowBox[{"tMax1", "/", 
    RowBox[{"(", 
     RowBox[{"nPoints", "-", "1"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"eulerStep1", "[", 
     RowBox[{"yList_", ",", " ", "kVal_"}], "]"}], ":=", 
    RowBox[{"yList", "+", 
     RowBox[{"dtEuler", "*", 
      RowBox[{"eulerRHS", "[", 
       RowBox[{"yList", ",", "kVal"}], "]"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"nSteps1", "=", 
   RowBox[{"nPoints", "-", "1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eulerSolve1", "[", "kVal_", "]"}], ":=", 
   RowBox[{"NestList", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"eulerStep1", "[", 
       RowBox[{"#", ",", "kVal"}], "]"}], "&"}], ",", 
     RowBox[{"{", 
      RowBox[{"1.0", ",", "0.0"}], "}"}], ",", "nSteps1"}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.987253147304606*^9, 3.987253162816099*^9}},
 CellLabel->
  "In[807]:=",ExpressionUUID->"19aaccce-52eb-43b6-b065-c98e5b88293a"]
}, Open  ]],

Cell["Let test if it work!", "Text",
 CellChangeTimes->{{3.9872531737039003`*^9, 
  3.987253178876679*^9}},ExpressionUUID->"bba20192-d433-4fbc-8940-\
6084ac679762"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"testSol1", "=", 
   RowBox[{"eulerSolve1", "[", "kTrue", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Initial [A] concentration:        \>\"", ",", 
   RowBox[{"testSol1", "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "]"}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Final [A]concentration:         \>\"", ",", 
   RowBox[{"testSol1", "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], "]"}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<True Final [A] concentration: \>\"", ",", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", "kTrue"}], "*", "tMax1"}], "]"}]}], "]"}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Error:              \>\"", ",", 
   RowBox[{"Abs", "[", 
    RowBox[{
     RowBox[{"testSol1", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}], "-", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "kTrue"}], "*", "tMax1"}], "]"}]}], "]"}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.987253190493882*^9, 3.987253233701454*^9}, 
   3.9875059424764442`*^9, {3.987506000154351*^9, 3.987506004413542*^9}, {
   3.9875061021604757`*^9, 3.987506130068631*^9}, {3.987506168961718*^9, 
   3.98750617081531*^9}, {3.987506245707719*^9, 3.9875062519310007`*^9}, 
   3.987509552221883*^9},
 CellLabel->
  "In[837]:=",ExpressionUUID->"3ea743ea-f0f6-4bec-a715-dd02fd7e0bb8"],

