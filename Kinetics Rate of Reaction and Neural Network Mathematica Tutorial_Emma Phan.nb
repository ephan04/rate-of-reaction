Cell[CellGroupData[{

Cell["\<\
3. Apply model created on Stage 2 on Blue1+H2O2 \[RightArrow] product \
reaction from Physical Chemistry 2 Lab (Student Exercise)\
\>", "Section",
 CellChangeTimes->{{3.987282091044346*^9, 
  3.987282116195524*^9}},ExpressionUUID->"e36a48ba-c264-43d6-9d23-\
6491c8325186"],

Cell["\<\
Now we have learn how to build neural network to learn and predict k constant \
 from using concentration of the species and the Euler method, let\
\[CloseCurlyQuote]s apply it to a experiment in Physical Chemistry Lab 2. 
The key is to follow what the experiment procedure suggested, which is set \
the [H2O2] 1000
times in excess of the Blue 1 to turn the reaction into a pseudo first order \
reaction so that we can apply the code in Stage 2. 
Another factor to consider is that different from dtEuler < 1 like the \
previous example the dtEuler in Stage is large and will effect gradient and \
loss function so have to reduce nStepNN and scale the dtEuler appropriately. 
Let\[CloseCurlyQuote]s build a neural network to model this reaction! \
\>", "Text",
 CellChangeTimes->{{3.987282125486269*^9, 3.987282214385994*^9}, {
  3.987282293769802*^9, 3.987282472117168*^9}, {3.987287823490285*^9, 
  3.987287845058817*^9}, {3.9872878780489407`*^9, 
  3.987287939509961*^9}},ExpressionUUID->"7bbcaad5-0ba8-4084-8141-\
165d9b8c2245"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
  "Solution", " ", "is", " ", "below", " ", "but", " ", "student", " ", "are",
    " ", "encourage", " ", "to", " ", "try", " ", "first"}], "*)"}]], "Input",\

 CellChangeTimes->{{3.987282475468936*^9, 
  3.987282490420629*^9}},ExpressionUUID->"cbbe3664-0c60-4991-8d5c-\
17b0310a0543"],

Cell[CellGroupData[{

Cell["1. Set up parameter", "Subsection",
 CellChangeTimes->{{3.9872833283805323`*^9, 
  3.987283331881278*^9}},ExpressionUUID->"6f6078d8-d22d-493b-80fb-\
839deab38a94"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"kTrue", "=", "0.111"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"H2O2conc", "=", "0.036"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kObs", "=", 
   RowBox[{"kTrue", "*", "H2O2conc"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"r", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"ktrue", "[", "H2O2", "]"}], "[", "Blue", "]"}], " ", "to", " ",
       "r"}], "=", 
     RowBox[{
      RowBox[{"kObs", "[", "Blue", "]"}], "for", " ", "pseudo", " ", "first", 
      " ", "reaction"}]}]}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.9872833356289587`*^9, 3.987283371118597*^9}, {
  3.987283446433144*^9, 3.98728347669982*^9}, {3.9872855139711723`*^9, 
  3.9872855155378532`*^9}, {3.987285763088441*^9, 3.9872857636183577`*^9}},
 CellLabel->
  "In[480]:=",ExpressionUUID->"bc53e841-f201-4342-a371-6105e57a0553"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"tMax3", "=", "900"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nPoints", "=", "50"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tGrid3", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", "tMax3", ",", 
     RowBox[{"tMax3", "/", 
      RowBox[{"(", 
       RowBox[{"nPoints", "-", "1"}], ")"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dtEuler", "=", 
   RowBox[{
    RowBox[{"tGrid3", "[", 
     RowBox[{"[", "2", "]"}], "]"}], "-", 
    RowBox[{"tGrid3", "[", 
     RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"nSteps", "=", "10"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<dtEuler:\>\"", ",", 
   RowBox[{"N", "[", "dtEuler", "]"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9872833931692133`*^9, 3.9872834009640617`*^9}, 
   3.9872854859511147`*^9, 3.987285529718751*^9, 3.987285686950913*^9, {
   3.987285739586636*^9, 3.987285780409214*^9}},
 CellLabel->
  "In[483]:=",ExpressionUUID->"14f20752-4dd3-4f22-bb36-28c5b232c2aa"],

