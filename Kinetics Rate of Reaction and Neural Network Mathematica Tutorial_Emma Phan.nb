Cell[BoxData[
 RowBox[{
  RowBox[{"trainResults", "=", 
   RowBox[{"NetTrain", "[", 
    RowBox[{"eulerSolveNet", ",", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Input\>\"", "->", "inputStatesN"}], ",", 
       RowBox[{"\"\<Output\>\"", "->", "targetStatesN"}]}], "|>"}], ",", 
     "All", ",", 
     RowBox[{"LossFunction", "->", 
      RowBox[{"MeanSquaredLossLayer", "[", "]"}]}], ",", 
     RowBox[{"MaxTrainingRounds", "->", "2000"}], ",", 
     RowBox[{"LearningRate", "->", "0.0001"}], ",", 
     RowBox[{"Method", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<ADAM\>\"", ",", 
        RowBox[{"\"\<GradientClipping\>\"", "->", "1.0"}]}], "}"}]}]}], 
    "]"}]}], "\n"}]], "Input",
 CellLabel->"In[44]:=",ExpressionUUID->"7d927189-3c4f-48a8-aa37-c2645424a9d8"],

