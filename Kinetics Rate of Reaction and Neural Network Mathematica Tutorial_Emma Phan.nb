}, Open  ]],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"because", " ", "the", " ", "dtEuler", " ", "is", " ", "large"}], ",",
    " ", 
   RowBox[{"nStepNN", " ", 
    RowBox[{"(", 
     RowBox[{
     "remember", " ", "dtEuler", " ", "is", " ", "apply", " ", "to", " ", 
      "eachround"}], ")"}], "have", " ", "to", " ", "be", " ", "reduced", " ",
     "and", " ", "apply", " ", "scaling"}]}], "*)"}]], "Input",
 CellChangeTimes->{{3.987287014062389*^9, 
  3.9872870790280933`*^9}},ExpressionUUID->"a09e23e0-1b31-4896-b3f8-\
c38877431204"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nStepsNN", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dtScale", "=", 
    RowBox[{"tMax3", "/", 
     RowBox[{"(", 
      RowBox[{"nPoints", "-", "1"}], ")"}]}]}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{"=", 
    RowBox[{"18.37", " ", "seconds", " ", "per", " ", "step"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dtEuler", "=", "1.0"}], ";"}], "                      ", 
  RowBox[{"(*", "normalized", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "rescale", " ", "kObs", " ", "to", " ", "match", " ", "unit", " ", "time", 
    " ", "steps"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"in", " ", "normalized", " ", 
     RowBox[{"time", ":", "kObsScaled"}]}], "=", 
    RowBox[{"kObs", "*", "dtScale"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"kObsScaled", "=", 
   RowBox[{"kObs", "*", "dtScale"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.987285784760181*^9, 3.987285795288553*^9}, {
   3.987285999068529*^9, 3.987286024508163*^9}, {3.987286142779661*^9, 
   3.987286142862488*^9}, 3.987287011114193*^9, {3.987287088641212*^9, 
   3.987287088912202*^9}},ExpressionUUID->"003c77b6-a66f-4fff-8310-\
1abf99aa5da0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Generate Data ", "Subsection",
 CellChangeTimes->{{3.987283430703974*^9, 
  3.9872834343964863`*^9}},ExpressionUUID->"12e8e0c8-7965-4ccd-8e3e-\
10bdeb741b7d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"initialBlue1s", "=", 
    RowBox[{"Range", "[", 
     RowBox[{"0.1", ",", "2.0", ",", "0.1"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"inputStatesN3", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"targetStatesN3", "=", 
    RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"b0", "=", "ib"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"clean", " ", "analytical", " ", "solution"}], "*)"}], 
      RowBox[{"Blue1clean", "=", 
       RowBox[{"b0", "*", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "kObsScaled"}], "*", "tGrid3"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Prodclean", "=", 
       RowBox[{"b0", "*", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "kObsScaled"}], "*", "tGrid3"}], "]"}]}], ")"}]}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{
         "5", "%", " ", "Gaussian", " ", "noise", " ", "like", " ", "Stage", " ",
           "1", " ", "Stage", " ", "2", " ", "and", " ", "Ji"}], "&"}], " ", 
        "Deng", " ", "paper"}], "*)"}], 
      RowBox[{"noiseB", "=", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"0", ",", "0.05"}], "]"}], ",", "nPoints"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"noiseP", "=", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"0", ",", "0.05"}], "]"}], ",", "nPoints"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "clamp", " ", "negative", " ", "concentrations", " ", "to", " ", 
        "zero"}], "*)"}], 
      RowBox[{"Blue1noisy", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"#", ",", "0"}], "]"}], "&"}], ",", 
         RowBox[{"Blue1clean", "*", 
          RowBox[{"(", 
           RowBox[{"1", "+", "noiseB"}], ")"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Prodnoisy", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"#", ",", "0"}], "]"}], "&"}], ",", 
         RowBox[{"Prodclean", "*", 
          RowBox[{"(", 
           RowBox[{"1", "+", "noiseP"}], ")"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"traj", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"Blue1noisy", ",", "Prodnoisy"}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "nStepsNN", " ", "step", " ", "pairs", " ", "within", " ", "each", " ",
         "trajectory", " ", "only"}], "*)"}], 
      RowBox[{"AppendTo", "[", 
       RowBox[{"inputStatesN3", ",", 
        RowBox[{"traj", "[", 
         RowBox[{"[", 
          RowBox[{"1", ";;", 
           RowBox[{
            RowBox[{"-", "nStepsNN"}], "-", "1"}]}], "]"}], "]"}]}], "]"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"targetStatesN3", ",", 
        RowBox[{"traj", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"nStepsNN", "+", "1"}], ";;"}], "]"}], "]"}]}], "]"}], 
      ";"}], ",", 
     RowBox[{"{", 
      RowBox[{"ib", ",", "initialBlue1s"}], "}"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"inputStatesN3", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"inputStatesN3", ",", "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"targetStatesN3", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"targetStatesN3", ",", "1"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.987283439145677*^9, 3.9872834399165792`*^9}, {
   3.987283488125599*^9, 3.98728359247691*^9}, 3.987283775700549*^9, 
   3.987287115612275*^9, {3.987287215710915*^9, 3.987287230918199*^9}},
 CellLabel->
  "In[598]:=",ExpressionUUID->"78d82114-4091-4d1b-a638-822971e8d5d6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Build Euler Step with Neural Network ", "Subsection",
 CellChangeTimes->{{3.9872837913124857`*^9, 
  3.9872838040195503`*^9}},ExpressionUUID->"88ec29c3-5912-4a6b-8cad-\
aa4af36ee09b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"nnEulerRHS3", "=", 
  RowBox[{"NetInitialize", "@", 
   RowBox[{"LinearLayer", "[", 
    RowBox[{"2", ",", 
     RowBox[{"\"\<Input\>\"", "->", "2"}], ",", 
     RowBox[{"\"\<Biases\>\"", "->", "None"}]}], "]"}]}]}], "\n", 
 RowBox[{"eulerStepNet3", "=", 
  RowBox[{"NetGraph", "[", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<rhs\>\"", "->", "nnEulerRHS3"}], ",", 
      RowBox[{"\"\<euler\>\"", "->", 
       RowBox[{"ThreadingLayer", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"y", ",", "dy"}], "}"}], ",", 
           RowBox[{"y", "+", 
            RowBox[{"dtEuler", "*", "dy"}]}]}], "]"}], ",", "2", ",", 
         RowBox[{"\"\<Input\>\"", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\"\<Input1\>\"", "->", 
             RowBox[{"{", "2", "}"}]}], ",", 
            RowBox[{"\"\<Input2\>\"", "->", 
             RowBox[{"{", "2", "}"}]}]}], "}"}]}]}], "]"}]}]}], "|>"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"NetPort", "[", "\"\<Input\>\"", "]"}], "->", 
       RowBox[{"NetPort", "[", 
        RowBox[{"\"\<euler\>\"", ",", "\"\<Input1\>\""}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"NetPort", "[", "\"\<Input\>\"", "]"}], "->", "\"\<rhs\>\""}], 
      ",", 
      RowBox[{"\"\<rhs\>\"", "->", 
       RowBox[{"NetPort", "[", 
        RowBox[{"\"\<euler\>\"", ",", "\"\<Input2\>\""}], "]"}]}]}], "}"}], ",", 
    RowBox[{"\"\<Input\>\"", "->", 
     RowBox[{"{", "2", "}"}]}], ",", 
    RowBox[{"\"\<Output\>\"", "->", 
     RowBox[{"{", "2", "}"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"eulerSolveNet3", "=", 
  RowBox[{"NetNestOperator", "[", 
   RowBox[{"eulerStepNet3", ",", "nStepsNN"}], 
   "]"}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.9872838209065933`*^9, 3.9872838510218153`*^9}},
 CellLabel->
  "In[604]:=",ExpressionUUID->"a315d98b-b20d-4548-97a4-39b5b3b7f6a9"],

