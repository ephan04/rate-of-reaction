Cell["\<\
Alright! Now that you have learn how to use Euler Step and build a loss \
function let\[CloseCurlyQuote]s incorporate neural network to recover true k \
value from noisy data! Level up +1!\
\>", "Text",
 CellChangeTimes->{{3.987253694066123*^9, 3.987253757103403*^9}, {
  3.98728042027147*^9, 
  3.987280434767125*^9}},ExpressionUUID->"f71920f7-a4d2-4946-b064-\
931d89dfff4f"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Stage 2:  Apply Euler method on first order reaction A\[RightArrow]B with \
neural network\
\>", "Section",
 CellChangeTimes->{{3.987253819319862*^9, 
  3.9872538308436813`*^9}},ExpressionUUID->"71304c1e-e922-4b57-86b0-\
d70bfe278498"],

Cell[CellGroupData[{

Cell["1. Set up parameter ", "Subsection",
 CellChangeTimes->{{3.98725457339261*^9, 3.987254598173993*^9}, 
   3.9872763432648277`*^9},ExpressionUUID->"c5f4af36-e590-4d15-9dcf-\
73cf806c0c52"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"kTrue", "=", "0.2"}], " ", ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "put", " ", "a", " ", "random", " ", "ktrue", " ", "for", " ", "a", " ", 
    "first", " ", "order", " ", "reaction"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tMax1", "=", " ", "20"}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nPoints", "=", "50"}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tGrid1", "=", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", "tMax1", ",", " ", 
      RowBox[{"tMax1", "/", 
       RowBox[{"(", 
        RowBox[{"nPoints", "-", "1"}], ")"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dtEuler", "=", 
   RowBox[{"tMax1", "/", 
    RowBox[{"(", 
     RowBox[{"nPoints", "-", "1"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nSteps1", "=", 
   RowBox[{"nPoints", "-", "1"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"nStepsNN", "=", "5"}], ";"}], "   ", 
  RowBox[{"(*", 
   RowBox[{
   "step", " ", "for", " ", "neural", " ", "network", " ", "in", " ", "the", " ",
     "later", " ", "section"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<dtEuler:\>\"", ",", 
   RowBox[{"N", "[", "dtEuler", "]"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.987254600263712*^9, 3.987254606487176*^9}, {
  3.987276331947942*^9, 3.987276347898752*^9}, {3.987276405641893*^9, 
