Cell[CellGroupData[{

Cell["Tutorial Content ", "Section",
 CellChangeTimes->{{3.987252148514867*^9, 
  3.9872521610828114`*^9}},ExpressionUUID->"55c32420-85f9-47a6-9578-\
081c3d8d7102"],

Cell["\<\
 Stage 1: Apply Euler method on first order reaction A\[RightArrow]B without \
neural network\
\>", "Item",
 CellChangeTimes->{{3.987252169163375*^9, 
  3.9872522236565447`*^9}},ExpressionUUID->"0df2a346-afa9-4062-839a-\
b264fcdd560b"],

Cell["\<\
Stage 2: Apply Euler method on first order reaction A\[RightArrow]B with \
neural network\
\>", "Item",
 CellChangeTimes->{{3.987252169163375*^9, 3.987252176100971*^9}, {
  3.987252250186489*^9, 
  3.9872522656314783`*^9}},ExpressionUUID->"f1a89a4e-6c03-48f7-bc5c-\
043fd0c27e67"],

Cell["\<\
Stage 3: Apply model created on Stage 2 on Blue1+H2O2 \[RightArrow] product \
reaction from Physical Chemistry 2 Lab\
\>", "Item",
 CellChangeTimes->{{3.987252169163375*^9, 3.987252176100971*^9}, {
  3.987252250186489*^9, 3.987252326691525*^9}, {3.987509470091228*^9, 
  3.987509471359765*^9}},ExpressionUUID->"2d214c0c-ff0e-4912-b936-\
9d7d7399c329"],

Cell["\<\
General Procedure
1. Set up parameters
2. Generate data
3. Build Euler step function 
4. Train neural net and or loss function 
5. Compare with true k value \
\>", "Text",
 CellChangeTimes->{{3.987252360379047*^9, 
  3.987252428302683*^9}},ExpressionUUID->"80e860b2-e7b1-45e4-b9b4-\
4a39a836e1b9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Stage 1: Apply Euler method on first order reaction A \[RightArrow]B without \
neural network\
\>", "Section",
 CellChangeTimes->{{3.987252435418426*^9, 3.987252453295157*^9}, 
   3.987277576025741*^9},ExpressionUUID->"de137045-6be0-40e6-a9f7-\
4d249ec63b8d"],

Cell[CellGroupData[{

Cell["1. Set up parameters ", "Subsection",
 CellChangeTimes->{{3.9872524607213507`*^9, 
  3.987252466170979*^9}},ExpressionUUID->"62206ed2-7c7f-404c-b531-\
441cf1937884"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"kTrue", "=", "0.2"}], " ", ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "put", " ", "a", " ", "random", " ", "ktrue", " ", "for", " ", "a", " ", 
    "first", " ", "order", " ", "reaction"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tMax1", "=", " ", "20"}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nPoints", "=", "50"}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tGrid1", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", "tMax1", ",", " ", 
     RowBox[{"tMax1", "/", 
      RowBox[{"(", 
       RowBox[{"nPoints", "-", "1"}], ")"}]}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9872524771783257`*^9, 3.987252484196995*^9}, {
  3.98750554983687*^9, 3.987505550091783*^9}},
 CellLabel->
  "In[800]:=",ExpressionUUID->"60fe0985-79c5-4d35-bcac-2b051087a623"]
}, Open  ]],

Cell["2. Generate data", "Subsection",
 CellChangeTimes->{{3.987252491897366*^9, 
  3.987252496933282*^9}},ExpressionUUID->"0860bf78-07b8-42c1-acab-\
7d4d8a1c68bb"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox[" Generate data of [A] for 50 time points by using the formula ", 
  "Text"],
 StyleBox["[A]=[", "Text",
  FontWeight->"Bold"],
 StyleBox[Cell[BoxData[
  FormBox[
   SubscriptBox["A", "0"], TraditionalForm]], "Text",
  FontWeight->"Bold",ExpressionUUID->"e82021d6-0f47-4df5-9e15-6d1e3460d109"], 
  "Text"],
 StyleBox["]", "Text",
  FontWeight->"Bold"],
 StyleBox[Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{"-", "kt"}]], TraditionalForm]], "Text",
  FontWeight->"Bold",ExpressionUUID->"b89c2303-a197-4730-b5c1-0642c06fa276"], 
  "Text"]
}], "Subsection",
 CellChangeTimes->{{3.987252510399654*^9, 
  3.987252658106637*^9}},ExpressionUUID->"b250ada5-342d-4253-b593-\
f918d77e7b99"],

Cell[CellGroupData[{

Cell["\<\
Add 5% Gaussian noise to create noisy data as Ji and Deng\[CloseCurlyQuote]s \
paper suggested\
\>", "Item",
 CellChangeTimes->{{3.987252510399654*^9, 
  3.987252690283033*^9}},ExpressionUUID->"a222d82f-325e-4584-b08b-\
9f695ba0aa9c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Adataclean", "=", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", "kTrue"}], "*", "tGrid1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"noise1", "=", 
   RowBox[{"RandomVariate", "[", 
    RowBox[{
     RowBox[{"NormalDistribution", "[", 
      RowBox[{"0", ",", "0.05"}], "]"}], ",", "nPoints"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Adata", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Max", "[", 
       RowBox[{"#", ",", "0"}], "]"}], "&"}], ",", " ", 
     RowBox[{"Adataclean", "*", 
      RowBox[{"(", 
       RowBox[{"1", "+", "noise1"}], ")"}]}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.987252699950282*^9, 3.987252704481166*^9}},
 CellLabel->
  "In[804]:=",ExpressionUUID->"5c83ca65-dd01-4375-97ba-1d78deb55fc3"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Euler Step ", "Subsection",
 CellChangeTimes->{{3.987252736609661*^9, 
  3.98725274309212*^9}},ExpressionUUID->"13c0a1fa-4d60-40d2-8433-\
88e55ea05f3a"],

Cell[CellGroupData[{

Cell[TextData[{
 " The ",
 Cell[BoxData[
 "eulerRHS"], "InlineCode",ExpressionUUID->
  "45b84ea4-2f69-41c4-9a0e-d5b75b171dcf"],
 " function create a list that contain the rate of change ",
 Cell[BoxData[
  FormBox[
   FractionBox["dA", "dt"], TraditionalForm]],ExpressionUUID->
  "e3c1f591-3cea-4101-be2b-49620f53e3cc"],
 " and ",
 Cell[BoxData[
  FormBox[
   FractionBox["dB", "dt"], TraditionalForm]],ExpressionUUID->
  "aa865780-bb29-41a2-8fc6-2a2d8508a2c2"],
 " with yList is the initial [A] and [B]"
}], "Item",
 CellChangeTimes->{{3.98725275325596*^9, 3.987252869903105*^9}, {
  3.987252909365266*^9, 
  3.9872529316734533`*^9}},ExpressionUUID->"66f84d80-3816-4724-8999-\
